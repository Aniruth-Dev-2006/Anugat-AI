# ============================================================
#  SAMAYAK SERVER — Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# ── Supabase PostgreSQL ──────────────────────────────────────
# From: Supabase → Project Settings → Database → Connection String
# Use "Transaction" mode URL (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use "Session" mode URL (port 5432) for DIRECT_URL (migrations only)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Redis (Upstash or local) ─────────────────────────────────
# Upstash: https://console.upstash.com → Create Database → REST URL
# Local Docker: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Demo Admin (pre-seeded credentials) ─────────────────────
DEMO_ADMIN_EMAIL=admin@samayak.demo
DEMO_ADMIN_PASSWORD=demo1234
